# URL of the Git repository you want to run inside Docker
GIT_REPO=https://github.com/your-org/your-pytorch-project.git

# Optional: branch/tag to checkout (default: main)
# GIT_BRANCH=main

# Optional: custom folder name after cloning
# PROJECT_NAME=my_project

# Optional: limit visible GPUs (comma‑separated, e.g., 0,1)
# GPU_IDS=0,1
