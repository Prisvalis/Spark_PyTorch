# Example environment file for the Docker container
# -------------------------------------------------
# URL of the Git repository to clone
GIT_REPO=https://github.com/your-org/your-repo.git

# Optional branch (defaults to main)
# GIT_BRANCH=main

# Optional project folder name (derived from repo URL if omitted)
# PROJECT_NAME=my_project

# Optional GPU IDs (comma‑separated, e.g., 0,1). Leave empty to expose all GPUs.
# GPU_IDS=